# For projects that use the Waf build system: https://waf.io/
# Dot-hidden on Unix-like systems
.waf-*-*/
.waf3-*-*/
# Hidden directory on Windows (no dot)
waf-*-*/
waf3-*-*/
# Lockfile
.lock-waf_*_build
# Sphinx
docs/build

build/

src/python/__pycache__
build_tools/__pycache__

*.pyc
*.pyo

# Rust build artefacts — generated by `cargo build`
src/rust/target/
# Cargo.lock is omitted for library crates (consumers control their own lock)
src/rust/Cargo.lock

.DS_Store
src/.DS_Store